/* pages/user/user.wxss */
.user{
  background-color: #ffffff;
  /* margin-top: 10px; */
  padding: 10px 15px;
  height: 60px;
  display: flex;
  align-items: center;
}
.user > .info{
  /* padding: 8px 0 0 15px; */
  padding-left: 30rpx;
}
.list{
  background-color: #ffffff;
  margin-top: 10px;
}
.list > .item{
  border-bottom: 1px solid #f5f5f5;
  padding-left: 20px;
  height: 45px;
}
.list > .item image{
  padding-top: 10px;
}
.list > .item > .t{
  line-height: 45px;
  padding-left: 10px;
}
.avatar{
  width: 80rpx;
  height: 80rpx;
  background: #0A60E2;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  margin-left: 30rpx;
  font-size: 40rpx;
  /* font-weight: bold; */
  color: #fff;
}