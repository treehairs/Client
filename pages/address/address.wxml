<!--pages/address/address.wxml-->
<Address wx:for="{{ addresses }}" wx:key="address_id" btn_show="{{ true }}" address="{{ item }}" bind:delete="getData" bind:edit="onEdit" bind:click="onClick"></Address>
<view class="add-icon">
  <van-icon name="plus" bind:tap="add" />
</view>
<van-popup show="{{ show }}" round position="bottom" bind:click-overlay="onClose" bind:close="onClose">
  <view class="add-address-box">
    <van-cell-group>
      <van-field model:value="{{ name }}" required label="收件人" placeholder="请输入收件人" />
      <van-field model:value="{{ telephone }}" label="手机号" placeholder="请输入手机号" required />
      <van-field model:value="{{ city }}" label="所在城市" placeholder="请输入城市" required />
      <van-field model:value="{{ street_address }}" label="所在地区" placeholder="请输入地区" required border="{{ false }}" />
      <van-button type="primary" block round class="submit-btn" bind:tap="onSubmit">完成编辑</van-button>

    </van-cell-group>
  </view>
</van-popup>