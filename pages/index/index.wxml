<!--pages/index/index.wxml-->
<van-action-sheet show="{{ show }}" actions="{{ actions }}" bind:close="onClose" bind:select="onSelect" cancel-text="取消" description="这是一段描述信息" />
<van-swipe-cell right-width="{{ 65 }}">
  <van-cell-group>
    <view class="cart">

    </view>
  </van-cell-group>
  <view slot="right" class="van-swipe-cell__right">删除</view>
</van-swipe-cell>

<van-skeleton title avatar row="3" />

<van-steps steps="{{ steps }}" active="{{ active }}" direction="vertical" active-color="#ee0a24" />

<van-sidebar active-key="{{ activeKey }}">
  <van-sidebar-item title="标签名" dot />
  <van-sidebar-item title="标签名" />
  <van-sidebar-item title="标签名" />
</van-sidebar>

<van-card
  num="2"
  tag="标签"
  price="10.00"
  desc="描述信息"
  title="商品标题"
  thumb="{{ imageURL }}"
>
  <view slot="footer">
    <van-button size="mini">按钮</van-button>
    <van-button size="mini">按钮</van-button>
  </view>
</van-card>

<tabbar></tabbar>