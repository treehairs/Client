<!--pages/product/product.wxml-->
<view class="info-container">
  <view class="product-image">
    <image src="{{ url + info.promo_image }}" mode="widthFix" class="image" />
  </view>
  <view class="product-text product-price">
    <text class="symbol">￥</text>
    <text class="price">{{ info.min_price }}</text>
    <text class="tip">起</text>
  </view>
  <view class="product-text product-name">
    {{ info.product_name }}
  </view>
  <view class="product-text description">
    {{ info.description }}
  </view>
  <view class="details">
    <view class="details-item">
      <text class="left">保障</text>
      <text class="right">七天无理由退货 · 免运费 · 假一赔十</text>
    </view>
    <view class="details-item">
      <text class="left">物流</text>
      <text class="right">发货 广东省广州市</text>
    </view>
  </view>
  <van-goods-action>
    <van-goods-action-icon icon="chat-o" text="客服" bind:tap="toChat"/>
    <van-goods-action-icon icon="cart-o" text="购物车" bind:tap="onClickCart" />
    <van-goods-action-button color="#be99ff" text="加入购物车" type="warning" bind:tap="onClickToCart" />
    <van-goods-action-button color="#7232dd" text="立即购买" bind:tap="onClickBuy" />
  </van-goods-action>
  <van-action-sheet bind:cancel="onCancel" bind:click-overlay="onClickOverlay" show="{{ show }}">
    <view class="variant-container">
      <view class="header">
        <image src="{{ url + info.promo_image }}" mode="widthFix" class="promo-image" />
        <text class="variant-price"><text class="symbol">￥</text>{{ variant_price }}</text>
      </view>
      <view class="address" bind:tap="onClickAddress">
        <view class="address-icon">
          <van-icon name="location" />
        </view>
        <view class="address-info">
          <text class="name">{{ address.recipient_name }} </text> 
          <text class="street-address">{{ address.street_address }} </text> 
          <text class="telephone">{{ address.telephone }}</text>
        </view>
      </view>
      <view class="variant-list-box">
        <text class="title">
          <van-icon name="bars" />规格
        </text>
        <view class="variant-list">
          <view class="variant-box {{ item.checked?'checked':''}}" wx:for="{{ variants }}" wx:key="variant_key" bind:tap="onClickVariantCard" data-id="{{ item.variant_id }}">
            <image src="{{ url + item.variant_image }}" mode="widthFix" class="variant-image" />
            <text class="variant-name">{{ item.variant_name }}</text>
            <text class="variant-options">{{ item.style }}+{{ item.specs }}</text>
          </view>
        </view>
      </view>
      <view class="quantity">
        <text>数量</text>
        <van-stepper value="{{ quantity }}" bind:change="onChange" />
      </view>
      <view class="bottom">
        <view class="bottom-header">
          <text>小计</text>
          <text class="variant-price"><text class="symbol">￥</text>{{ variant_price * quantity }}</text>
        </view>
        <view class="btn-box">
          <van-button wx:if="{{clickEvent==='buy'}}" disabled="{{ selected_variant===null }}" round block color="linear-gradient(to right, #4bb0ff, #6149f6)" bind:tap="balance">去结算</van-button>
          <van-button wx:else disabled="{{ selected_variant===null }}" round block color="linear-gradient(to right, #4bb0ff, #6149f6)" bind:tap="addItem">加入购物车</van-button>
        </view>
      </view>
    </view>
  </van-action-sheet>

</view>